// Prisma schema — PostgreSQL (Prisma 7)
// 注意：连接 URL 已从 schema 中移除，统一在 prisma.config.ts 中配置
// 运行时通过 @prisma/adapter-pg 的 driver adapter 连接数据库
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  password  String?
  avatarUrl String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  mindmaps  Mindmap[]
}

model Mindmap {
  id        String   @id @default(cuid())
  title     String
  data      Json
  sourceDoc String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}
