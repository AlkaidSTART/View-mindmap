// Prisma schema — PostgreSQL
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  password  String?
  avatarUrl String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  mindmaps  Mindmap[]
}

model Mindmap {
  id        String   @id @default(cuid())
  title     String
  // 思维导图节点数据，JSON 形式持久化
  data      Json
  sourceDoc String?  // 原始文档名 / URL
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}
